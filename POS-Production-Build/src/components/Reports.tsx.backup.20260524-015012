export default function Reports() {
  const [reportType, setReportType] = useState('sales');
  const [dateRange, setDateRange] = useState('week'); // Default to week to match actual data
  const [customerSearch, setCustomerSearch] = useState(''); // Customer name search filter
  const [supplierSearch, setSupplierSearch] = useState(''); // Supplier name search filter
  const [loading, setLoading] = useState(true);
  const [reportData, setReportData] = useState<any>(null);
  const [summaryStatsState, setSummaryStatsState] = useState<any>({
    totalRevenue: 0,
    totalOrders: 0,
    activeCustomers: 0,
    activeSuppliers: 0,
    revenueChange: 0,
    ordersChange: 0,
    customersChange: 0
  });

  useEffect(() => {
    // Debounce rapid filter changes to improve performance
    const timeoutId = setTimeout(() => {
      loadReportData();
    }, 100); // 100ms debounce
    
    return () => clearTimeout(timeoutId); // Cleanup on unmount or change
  }, [reportType, dateRange]);

  const getDateRange = () => {
    const now = new Date();
    const startDate = new Date();
    
    switch (dateRange) {
      case 'week':
        startDate.setDate(now.getDate() - 7);
        break;
      case 'month':
        startDate.setMonth(now.getMonth() - 1);
        break;
      case 'quarter':
        startDate.setMonth(now.getMonth() - 3);
        break;
      case 'year':
        startDate.setFullYear(now.getFullYear() - 1);
        break;
      default:
        startDate.setDate(now.getDate() - 7);
    }
    
    // Set end date to end of day (23:59:59) to include all orders from that day
    const endDate = new Date(now);
    endDate.setHours(23, 59, 59, 999);
    
    return {
      startDate: startDate.toISOString().split('T')[0],
      endDate: endDate.toISOString().split('T')[0]
    };
  };

  const loadReportData = async () => {
    try {
      setLoading(true);
      
      // Add timeout to prevent hanging
      const timeoutPromise = new Promise((_, reject) => 
        setTimeout(() => reject(new Error('Request timeout')), 10000) // 10 second timeout
      );
      
      const { startDate, endDate } = getDateRange();
      
      // Load report data based on type with timeout
      let data;
      switch (reportType) {
        case 'sales':
          data = await Promise.race([
            api.getSalesAnalytics({ startDate, endDate }),
            timeoutPromise
          ]);
          break;
        case 'customer':
          data = await Promise.race([
            api.getCustomerReport({ startDate, endDate }),
            timeoutPromise
          ]);
          break;
        case 'supplier':
          data = await Promise.race([
            api.getSupplierReport({ startDate, endDate }),
            timeoutPromise
          ]);
          break;
        case 'employee':
          data = await Promise.race([
            api.getEmployeeReport({ startDate, endDate }),
            timeoutPromise
          ]);
          break;
        case 'creditDebit':
          data = await Promise.race([
            api.getTransactions({ startDate, endDate }),
            timeoutPromise
          ]);
          console.log('📊 Credit/Debit Report Data:', data);
          break;
        case 'generalLedger':
          const [transactions, salesData] = await Promise.all([
            Promise.race([api.getTransactions({ startDate, endDate }), timeoutPromise]) as Promise<any>,
            Promise.race([api.getSalesAnalytics({ startDate, endDate }), timeoutPromise]) as Promise<any>
          ]);
          console.log('📊 General Ledger Data:', { transactions, salesData });
          data = { 
            ledger: transactions.transactions || [],
            sales: salesData,
            summary: transactions.summary
          };
          break;
        case 'profitLoss':
          data = await Promise.race([
            api.getSalesAnalytics({ startDate, endDate }),
            timeoutPromise
          ]);
          break;
        default:
          data = null;
      }
      
      setReportData(data);
      
      // Calculate summary statistics for Sales Report only
      if (reportType === 'sales' && data) {
        calculateSummaryStats(data, startDate, endDate);
      }
    } catch (error: any) {
      console.error('❌ Failed to load report:', error);
      toast.error('Failed to load report data');
    } finally {
      setLoading(false);
    }
  };

  const calculateSummaryStats = async (data: any, startDate: string, endDate: string) => {
    try {
      // Calculate previous period for comparison
      const start = new Date(startDate);
      const end = new Date(endDate);
      const daysDiff = Math.ceil((end.getTime() - start.getTime()) / (1000 * 60 * 60 * 24));
      
      const prevStart = new Date(start);
      prevStart.setDate(prevStart.getDate() - daysDiff);
      const prevEnd = new Date(start);
      prevEnd.setDate(prevEnd.getDate() - 1);
      
      // Get previous period data
      const prevData = await api.getSalesAnalytics({ 
        startDate: prevStart.toISOString().split('T')[0],
        endDate: prevEnd.toISOString().split('T')[0]
      });
      
      // Calculate current period totals
      const currentRevenue = data.dailySales?.reduce((sum: number, day: any) => sum + day.revenue, 0) || 0;
      const currentOrders = data.dailySales?.reduce((sum: number, day: any) => sum + day.orders, 0) || 0;
      
      // Calculate previous period totals
      const prevRevenue = prevData.dailySales?.reduce((sum: number, day: any) => sum + day.revenue, 0) || 0;
      const prevOrders = prevData.dailySales?.reduce((sum: number, day: any) => sum + day.orders, 0) || 0;
      
      // Calculate unique customers (from orders)
      const orders = await api.getOrders();
      const uniqueCustomers = new Set(
        (orders.orders || [])
          .filter((o: any) => o.customer_name && o.customer_name !== 'Walk-in Customer')
          .map((o: any) => o.customer_name)
      ).size;
      
      // Get active suppliers count
      const suppliers = await api.getSuppliers();
      const activeSuppliers = (suppliers || []).filter((s: any) => s.status === 'active').length;
      
      // Calculate percentage changes
      const revenueChange = prevRevenue > 0 ? ((currentRevenue - prevRevenue) / prevRevenue * 100) : 0;
      const ordersChange = prevOrders > 0 ? ((currentOrders - prevOrders) / prevOrders * 100) : 0;
      
      console.log('📈 Summary Stats Calculated:', {
        currentRevenue,
        currentOrders,
        uniqueCustomers,
        activeSuppliers,
        revenueChange: revenueChange.toFixed(1),
        ordersChange: ordersChange.toFixed(1)
      });
      
      setSummaryStatsState({
        totalRevenue: currentRevenue,
        totalOrders: currentOrders,
        activeCustomers: uniqueCustomers,
        activeSuppliers: activeSuppliers,
        revenueChange: parseFloat(revenueChange.toFixed(1)),
        ordersChange: parseFloat(ordersChange.toFixed(1)),
        customersChange: 15 // Can be calculated if we track historical customer data
      });
    } catch (error) {
      console.error(' Error calculating summary stats:', error);
    }
  };

  const downloadPDF = () => {
    // Validate data is loaded
    if (loading || !reportData) {
      toast.error('Please wait for report data to load before exporting PDF');
      return;
    }
    
    console.log('📄 PDF Export - Report Type:', reportType);
    console.log('📊 PDF Export - Report Data:', reportData);
    console.log('📊 PDF Export - Data Keys:', Object.keys(reportData));
    
    toast.success(`Generating ${reportType} report PDF...`);
    
    // Create a new window for PDF generation
    const printWindow = window.open('', '_blank');
    if (!printWindow) {
      toast.error('Please allow popups to download PDF');
      return;
    }

    // Get report title
    const reportTitles: { [key: string]: string } = {
      sales: 'Sales Report',
      customer: 'Customer Report',
      supplier: 'Supplier Report',
      employee: 'Employee Report',
      creditDebit: 'Credit/Debit Report',
      generalLedger: 'General Ledger Report',
      profitLoss: 'Profit & Loss Report'
    };
    const reportTitle = reportTitles[reportType] || 'Report';

    // Generate HTML content for PDF using professional template
    let htmlContent = generateProfessionalPDFHeader(reportTitle, dateRange);
    
    // Generate report-specific content
    if (!reportData) {
      htmlContent += `<p>No data available for this report.</p>`;
    } else {
    switch (reportType) {
      case 'sales':
        // Calculate totals from dailySales
        const totalRevenue = reportData.dailySales?.reduce((sum: number, day: any) => sum + day.revenue, 0) || 0;
        const totalOrders = reportData.dailySales?.reduce((sum: number, day: any) => sum + day.orders, 0) || 0;
        const avgOrderValue = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;
        
        htmlContent += `
          <div class="section-title">Sales Summary</div>
          <div class="summary-grid">
            <div class="summary-card">
              <div class="summary-label">Total Revenue</div>
              <div class="summary-value">Rs ${totalRevenue.toLocaleString()}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Total Orders</div>
              <div class="summary-value">${totalOrders}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Average Order Value</div>
              <div class="summary-value">Rs ${avgOrderValue.toLocaleString()}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Active Days</div>
              <div class="summary-value">${reportData.dailySales?.length || 0}</div>
            </div>
          </div>
          
          <div class="section-title" style="margin-top: 30px;">Daily Breakdown</div>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Orders</th>
                <th>Revenue</th>
                <th>Avg Order Value</th>
              </tr>
            </thead>
            <tbody>
              ${(reportData.dailySales || []).map((day: any) => `
                <tr>
                  <td>${new Date(day.date).toLocaleDateString()}</td>
                  <td>${day.orders}</td>
                  <td>Rs ${day.revenue.toLocaleString()}</td>
                  <td>Rs ${day.orders > 0 ? Math.round(day.revenue / day.orders).toLocaleString() : 0}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
        break;

      case 'customer':
        // Calculate customer segments for PDF
        const allCust = reportData.customers || [];
        const custSummary = reportData.summary || {};
        
        // Filter by search if provided
        const filteredCust = customerSearch
          ? allCust.filter((c: any) => 
              (c.name || '').toLowerCase().includes(customerSearch.toLowerCase()) ||
              (c.phone || '').includes(customerSearch)
            )
          : allCust;
        
        const segments = {
          VIP: { count: 0, value: 0 },
          Regular: { count: 0, value: 0 },
          New: { count: 0, value: 0 }
        };
        
        filteredCust.forEach((customer: any) => {
          if (customer.totalSpent >= 5000) {
            segments.VIP.count++;
            segments.VIP.value += customer.totalSpent;
          } else if (customer.totalSpent >= 1000) {
            segments.Regular.count++;
            segments.Regular.value += customer.totalSpent;
          } else {
            segments.New.count++;
            segments.New.value += customer.totalSpent;
          }
        });
        
        const customerSegments: any[] = [
          { segment: 'VIP', count: segments.VIP.count, value: segments.VIP.value, percentage: 0 },
          { segment: 'Regular', count: segments.Regular.count, value: segments.Regular.value, percentage: 0 },
          { segment: 'New', count: segments.New.count, value: segments.New.value, percentage: 0 }
        ];
        
        const totalCust = filteredCust.length;
        customerSegments.forEach(seg => {
          seg.percentage = totalCust > 0 ? Math.round((seg.count / totalCust) * 100) : 0;
        });
        
        htmlContent += `
          <div class="section-title">Customer Summary</div>
          ${customerSearch ? `<p style="margin-bottom: 15px; color: #666;">Search: "${customerSearch}" - ${filteredCust.length} customer(s) found</p>` : ''}
          <div class="summary-grid">
            <div class="summary-card">
              <div class="summary-label">Total Customers</div>
              <div class="summary-value">${custSummary.totalCustomers || filteredCust.length}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Total Revenue</div>
              <div class="summary-value">Rs ${(custSummary.totalRevenue || 0).toLocaleString()}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Avg Customer Value</div>
              <div class="summary-value">Rs ${(custSummary.averageCustomerValue || 0).toLocaleString()}</div>
            </div>
            <div class="summary-card">
              <div class="summary-label">Avg Visits</div>
              <div class="summary-value">${(custSummary.averageVisitsPerCustomer || 0).toFixed(1)}</div>
            </div>
          </div>
          
          <div class="section-title" style="margin-top: 30px;">Customer Segments</div>
          <table>
            <thead>
              <tr>
                <th>Segment</th>
                <th>Count</th>
                <th>Percentage</th>
                <th>Total Value</th>
                <th>Avg Value per Customer</th>
              </tr>
            </thead>
            <tbody>
              ${customerSegments.map(item => `
                <tr>
                  <td><span class="badge ${item.segment === 'VIP' ? 'badge-active' : ''}">${item.segment}</span></td>
                  <td>${item.count}</td>
                  <td>${item.percentage}%</td>
                  <td>Rs ${item.value.toLocaleString()}</td>
                  <td>Rs ${item.count > 0 ? Math.round(item.value / item.count).toLocaleString() : 0}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
          
          <div class="section-title" style="margin-top: 30px;">Top 10 Customers with Store Visits</div>
          <table>
            <thead>
              <tr>
                <th>Customer Name</th>
                <th>Phone</th>
                <th>Store Visits</th>
                <th>Total Orders</th>
                <th>Total Spent</th>
                <th>Avg Order Value</th>
                <th>Last Visit</th>
              </tr>

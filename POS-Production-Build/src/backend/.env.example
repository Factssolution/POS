# ========================================
# POS System - Production Environment Config
# ========================================
# Copy this file to .env and update values
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_system
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Timezone (for scheduled backups)
TZ=Asia/Karachi

# ========================================
# Backup Encryption Configuration
# ========================================
# Enable encryption for backup files
BACKUP_ENCRYPTION_ENABLED=false

# Encryption key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=

# ========================================
# Email Notification Configuration
# ========================================
# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email addresses
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=admin@factssolution.com

# Enable/disable email notifications
EMAIL_ENABLED=false

# ========================================
# Optional: Cloud Storage (Future)
# ========================================
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

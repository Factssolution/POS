              <TableRow className="bg-green-50">
                <TableCell className="font-bold">Revenue</TableCell>
                <TableCell className="text-right font-bold text-green-600">Rs {Math.round(totalRevenue).toLocaleString()}</TableCell>
                <TableCell className="text-right">100%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Cost of Goods Sold</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(costOfGoodsSold).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (costOfGoodsSold / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow className="bg-blue-50">
                <TableCell className="font-semibold">Gross Profit</TableCell>
                <TableCell className="text-right font-semibold text-blue-600">Rs {Math.round(grossProfit).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (grossProfit / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Salaries & Wages</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(salaries).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (salaries / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Rent & Lease</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(rent).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (rent / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Utilities</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(utilities).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (utilities / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Marketing & Advertising</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(marketing).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (marketing / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow>
                <TableCell className="pl-8">Other Expenses</TableCell>
                <TableCell className="text-right text-red-600">- Rs {Math.round(other).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (other / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow className="bg-gray-100">
                <TableCell className="font-semibold">Total Expenses</TableCell>
                <TableCell className="text-right font-semibold text-red-600">- Rs {Math.round(totalExpenses).toLocaleString()}</TableCell>
                <TableCell className="text-right">{(totalRevenue > 0 ? (totalExpenses / totalRevenue) * 100 : 0).toFixed(1)}%</TableCell>
              </TableRow>
              <TableRow className="bg-green-100 border-t-2">
                <TableCell className="font-bold text-lg">Net Profit</TableCell>
                <TableCell className="text-right font-bold text-lg" style={{ color: netProfit >= 0 ? '#388e3c' : '#d32f2f' }}>
                  Rs {Math.round(netProfit).toLocaleString()}
                </TableCell>
                <TableCell className="text-right font-bold">{profitMargin.toFixed(1)}%</TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </CardContent>
      </Card>
    </div>
    );
  }, [reportData]);

  const reportComponents = useMemo(() => ({
    sales: renderSalesReport,
    customer: renderCustomerReport,
    supplier: renderSupplierReport,
    employee: renderEmployeeReport,
    creditDebit: renderCreditDebitReport,
    generalLedger: renderGeneralLedgerReport,
    profitLoss: renderProfitLossReport,
  }), [renderSalesReport, renderCustomerReport, renderSupplierReport, renderEmployeeReport, renderCreditDebitReport, renderGeneralLedgerReport, renderProfitLossReport]);

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2>Reports & Analytics</h2>
          <p className="text-muted-foreground">Generate and view detailed business reports</p>
        </div>
        <div className="flex gap-2">
          <Button variant="outline" onClick={downloadPDF}>
            <Download className="w-4 h-4 mr-2" />
            Download PDF
          </Button>
          <Button variant="outline" onClick={downloadCSV}>
            <FileDown className="w-4 h-4 mr-2" />
            Download CSV
          </Button>
        </div>
      </div>

      {/* Filters */}
      <Card>
        <CardContent className="pt-6">
          <div className="flex flex-col sm:flex-row gap-4">
            <div className="flex-1">
              <Select value={reportType} onValueChange={setReportType}>
                <SelectTrigger>
                  <SelectValue placeholder="Select report type" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="sales">Sales Report</SelectItem>
                  <SelectItem value="customer">Customer Report</SelectItem>
                  <SelectItem value="supplier">Supplier Report</SelectItem>
                  <SelectItem value="employee">Employee Report</SelectItem>
                  <SelectItem value="creditDebit">Credit/Debit Report</SelectItem>
                  <SelectItem value="generalLedger">General Ledger Report</SelectItem>
                  <SelectItem value="profitLoss">Profit & Loss Report</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div className="flex-1">
              <Select value={dateRange} onValueChange={setDateRange}>
                <SelectTrigger>
                  <SelectValue placeholder="Select date range" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="week">This Week</SelectItem>
                  <SelectItem value="month">This Month</SelectItem>
                  <SelectItem value="quarter">This Quarter</SelectItem>
                  <SelectItem value="year">This Year</SelectItem>
                </SelectContent>
              </Select>
            </div>
            {/* Customer Name Search - Only visible for Customer Report */}
            {reportType === 'customer' && (
              <div className="flex-1">
                <input
                  type="text"
                  placeholder="Search customer by name..."
                  value={customerSearch}
                  onChange={(e) => setCustomerSearch(e.target.value)}
                  className="w-full px-3 py-2 border border-input rounded-md bg-background text-sm"
                />
              </div>
            )}
            {/* Supplier Name Search - Only visible for Supplier Report */}
            {reportType === 'supplier' && (
              <div className="flex-1">
                <input
                  type="text"
                  placeholder="Search supplier by name..."
                  value={supplierSearch}
                  onChange={(e) => setSupplierSearch(e.target.value)}
                  className="w-full px-3 py-2 border border-input rounded-md bg-background text-sm"
                />
              </div>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Quick Stats */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm">Total Revenue</CardTitle>
            <DollarSign className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">Rs {summaryStatsState.totalRevenue.toLocaleString()}</div>
            <p className="text-xs text-muted-foreground">
              {summaryStatsState.revenueChange !== 0 ? 
                `${summaryStatsState.revenueChange > 0 ? '+' : ''}${summaryStatsState.revenueChange}% from last period` : 
                'No previous data'}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm">Total Orders</CardTitle>
            <FileText className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{summaryStatsState.totalOrders.toLocaleString()}</div>
            <p className="text-xs text-muted-foreground">
              {summaryStatsState.ordersChange !== 0 ? 
                `${summaryStatsState.ordersChange > 0 ? '+' : ''}${summaryStatsState.ordersChange}% from last period` : 
                'No previous data'}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm">Active Customers</CardTitle>
            <Users className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{summaryStatsState.activeCustomers}</div>
            <p className="text-xs text-muted-foreground">
              {summaryStatsState.customersChange > 0 ? 
                `+${summaryStatsState.customersChange}% from last period` : 
                'No change'}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm">Active Suppliers</CardTitle>
            <Truck className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{summaryStatsState.activeSuppliers}</div>
            <p className="text-xs text-muted-foreground">No change</p>
          </CardContent>
        </Card>
      </div>

      {/* Report Content */}
      {loading ? (
        <Card>
          <CardContent className="py-12 text-center">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
            <p className="text-muted-foreground">Loading report data...</p>
          </CardContent>
        </Card>
      ) : (
        reportComponents[reportType as keyof typeof reportComponents]()
      )}
    </div>
  );
}
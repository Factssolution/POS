# Node Environment
NODE_ENV=production

# ============================================
# HOW TO GET THESE VALUES:
# ============================================
# 
# 1. SUPABASE_SERVICE_ROLE_KEY:
#    - Go to: https://supabase.com/dashboard/project/hfusrtiqjyiotjewzzkt/settings/api
#    - Copy "service_role" key (NOT anon key!)
#    - This is different from anon key
#
# 2. DATABASE_URL:
#    - Go to: https://supabase.com/dashboard/project/hfusrtiqjyiotjewzzkt/settings/database
#    - Find "Transaction" pooler
#    - Copy connection string
#    - Replace [YOUR-PASSWORD] with actual password
#
# 3. JWT_SECRET:
#    - Can be any long random string
#    - Example: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ============================================

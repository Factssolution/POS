{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/minimal-handler.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/minimal-handler.cjs"
    },
    {
      "src": "/health",
      "dest": "/api/minimal-handler.cjs"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/minimal-handler.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

# =====================================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION
# =====================================================
# Add these variables to your Vercel project settings:
# https://vercel.com/dashboard -> Your Project -> Settings -> Environment Variables

# =====================================================
# FRONTEND VARIABLES (VITE_ prefix - available in browser)
# =====================================================

# Backend API URL (Vercel deployment)
# Format: https://your-vercel-domain.vercel.app/api/v1
VITE_API_URL=https://your-domain.vercel.app/api/v1

# Supabase Configuration (if using Supabase auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =====================================================
# BACKEND VARIABLES (No prefix - server-side only)
# =====================================================

# Environment
NODE_ENV=production

# Database Configuration (Supabase PostgreSQL)
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SSL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
# Add your Vercel frontend URL here
CORS_ORIGIN=https://your-domain.vercel.app,http://localhost:5173

# =====================================================
# INSTRUCTIONS FOR VERCEL SETUP:
# =====================================================
# 1. Go to Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# 2. Add each variable for ALL environments (Production, Preview, Development)
# 3. For VITE_ variables: These will be available in frontend code
# 4. For other variables: These are server-side only (backend)
# 5. Redeploy your application after adding environment variables
# =====================================================
